# your-domain.example — EvolvedCV (static site + optional /api/contact endpoint).
#
# Copy this block into your Caddyfile (e.g. the one mounted into your
# `caddy` Docker container), then validate and reload:
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec caddy caddy reload   --config /etc/caddy/Caddyfile
#
# Mount: /path/to/evolved-cv/site must be visible inside the caddy container.
# Add a bind mount such as `- /path/to/evolved-cv/site:/path/to/evolved-cv/site:ro`
# in your docker-compose.yml.

your-domain.example {
	# Optional: proxy the contact form to your automation backend
	# so the real webhook URL is never exposed to the browser.
	handle /api/contact {
		reverse_proxy https://your-automation-host.example/webhook/contact
	}

	# Everything else → the static site.
	handle {
		root * /path/to/evolved-cv/site
		encode gzip zstd

		# Dev-only leftovers (the deploy script excludes them) → 404 anyway.
		@blocked path /test.html /js/test-suite.js /proposals/*
		respond @blocked 404

		# Caching. CODE + markup revalidate every time (no-cache + ETag → instant
		# redeploys, no stale JS/CSS). Only heavy, rarely-changing media gets a
		# real cache.
		@nocache path / *.html *.json *.css *.js *.mjs
		header @nocache Cache-Control "no-cache"
		@media path *.woff2 *.ttf *.png *.jpg *.jpeg *.svg *.webp *.ico
		header @media Cache-Control "public, max-age=86400"

		file_server
	}
}
